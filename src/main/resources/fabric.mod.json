{
  "schemaVersion": 1,
  "id": "kiwi",
  "version": "${version}",
  "name": "Kiwi",
  "description": "Client-side autonomous agent with task planning and pathfinding for Minecraft",
  "authors": [],
  "contact": {},
  "license": "GPL-3.0",
  "icon": "assets/kiwi/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "org.kvxd.kiwi.Kiwi"
    ],
    "fabric-gametest": [
      "org.kvxd.kiwi.test.HarvestDropGameTests",
      "org.kvxd.kiwi.test.HarvestLookupGameTests",
      "org.kvxd.kiwi.test.RegistryGameTests",
      "org.kvxd.kiwi.test.RecipeGameTests",
      "org.kvxd.kiwi.test.TagResolverGameTests"
    ],
    "fabric-datagen": [
      "org.kvxd.kiwi.datagen.KiwiDataGenerator"
    ]
  },
  "mixins": [
    "kiwi.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-language-kotlin": ">=${kotlin_loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}"
  }
}
